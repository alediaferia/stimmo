# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Compiled Babel message catalogs — generated artifacts, not committed
src/stimmo/locale/**/*.mo

# Virtual environments
.venv

# Local environment / secrets
.env

# Editor
.vscode/
.idea/

# OMI staging directories (Forniture OMI downloads, imported then deleted)
src/stimmo/data/assets/omi-*/

# Share-link SQLite store (default local dev path; production uses STIMMO_SHARE_DB)
# and the licensed neighborhood editorial content file (data/neighborhoods.py,
# default local dev path; the release image bakes real copy in at build time —
# see Dockerfile + release.yml) are both repo-local and git-ignored. The one
# exception is var/content/.gitkeep: tracked only so the directory — and the
# Dockerfile's optional COPY of neighborhoods.json alongside it — exist for a
# plain `docker build .` with no content present.
var/*
!var/content/
var/content/*
!var/content/.gitkeep

# Claude Code (and other agent CLIs) — session-scoped or personal, never share.
# Shared, portable config lives in .claude/settings.json and .claude/agents/ (committed).
.claude/plans/
.claude/reports/
.claude/journals/
.claude/memory/
.claude/settings.local.json

# Other agent tooling
.aider*
.cursor/
.windsurfrules
.continue/

# Local docs scratchpad
docs/plans/

# Deployment runbook — personal ops docs, not relevant to contributors
deploy/

# Agent definition symlinked in from a private sibling repo — the target is not part
# of this project and must not be committed here.
.claude/agents/stimmo-seo-manager.md
