# uses STIMMO_CONTENT_DIR) — see data/neighborhoods.py. Both repo-local, git-ignored.
var/

# Claude Code (and other agent CLIs) — session-scoped or personal, never share.
# Shared, portable config lives in .claude/settings.json and .claude/agents/ (committed).
.claude/plans/
.claude/reports/
.claude/journals/
.claude/memory/
.claude/settings.local.json

