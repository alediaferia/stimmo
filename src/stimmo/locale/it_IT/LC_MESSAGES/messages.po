#: src/stimmo/web/templates/about.html:2
msgid "about"
msgstr "informazioni"

#: src/stimmo/web/templates/about.html:8 src/stimmo/web/templates/base.html:879
msgid "About"
msgstr "Informazioni"

#: src/stimmo/web/templates/about.html:10
msgid "How stimmo turns an address<br>into <em>a verdict</em>."
msgstr "Come stimmo trasforma un indirizzo<br>in <em>un verdetto</em>."

#: src/stimmo/web/templates/about.html:11
msgid ""
"A six-step pipeline, one coefficients file, no machine learning. Same "
"inputs, same output — every time."
msgstr ""
"Una pipeline in sei passaggi, un file di coefficienti, nessun machine "
"learning. Stessi input, stesso output — ogni volta."

#: src/stimmo/web/templates/about.html:14
#: src/stimmo/web/templates/form.html:218
msgid "Methodology"
msgstr "Metodologia"

#: src/stimmo/web/templates/about.html:16
msgid "microzones · Milano"
msgstr "microzone · Milano"

#: src/stimmo/web/templates/about.html:26
msgid ""
"A transparent, OMI-anchored fair-price check<br>\n"
"      for Milan apartment listings."
msgstr ""
"Un controllo del prezzo equo trasparente e ancorato all'OMI<br>\n"
"      per gli annunci di appartamenti a Milano."

#: src/stimmo/web/templates/about.html:39
#: src/stimmo/web/templates/result.html:37
msgid "fair"
msgstr "equo"

#: src/stimmo/web/templates/about.html:40
msgid "over"
msgstr "sopra"

#: src/stimmo/web/templates/about.html:41
msgid "under"
msgstr "sotto"

#: src/stimmo/web/templates/about.html:42
msgid "Verdicts"
msgstr "Verdetti"

#: src/stimmo/web/templates/about.html:50
msgid "The pipeline"
msgstr "La pipeline"

#: src/stimmo/web/templates/about.html:51
msgid "Address → verdict · 6 steps"
msgstr "Indirizzo → verdetto · 6 passaggi"

#: src/stimmo/web/templates/about.html:56
msgid "Geocode"
msgstr "Geocodifica"

#: src/stimmo/web/templates/about.html:56
msgid ""
"OSM Nominatim resolves the address to lat / lon. Queries are restricted "
"to Milano comune."
msgstr ""
"OSM Nominatim risolve l'indirizzo in lat/lon. Le query sono limitate al "
"comune di Milano."

#: src/stimmo/web/templates/about.html:60
msgid "Locate the OMI zone"
msgstr "Individua la zona OMI"

#: src/stimmo/web/templates/about.html:60
msgid "Point-in-polygon against Milano's official OMI microzone shapes."
msgstr ""
"Point-in-polygon rispetto alle forme ufficiali delle microzone OMI di "
"Milano."

#: src/stimmo/web/templates/about.html:64
msgid "Pull the €/m² band"
msgstr "Ottieni la fascia €/m²"

#: src/stimmo/web/templates/about.html:64
msgid "Compr_min – Compr_max for that zone × property type × condition bucket."
msgstr ""
"Compr_min – Compr_max per quella zona × tipologia immobiliare × fascia di"
" condizione."

#: src/stimmo/web/templates/about.html:68
msgid "Count amenities"
msgstr "Conta i servizi"

#: src/stimmo/web/templates/about.html:68
msgid "OSM Overpass — schools, transit, markets, pharmacies, parks within 500 m."
msgstr "OSM Overpass — scuole, trasporti, mercati, farmacie, parchi entro 500 m."

#: src/stimmo/web/templates/about.html:72
msgid "Adjust the band"
msgstr "Regola la fascia"

#: src/stimmo/web/templates/about.html:72
msgid ""
"A single coefficients table multiplies floor, lift, energy, outdoor, era,"
" orientation, amenities."
msgstr ""
"Un'unica tabella di coefficienti moltiplica piano, ascensore, energia, "
"esterno, epoca, orientamento, servizi."

#: src/stimmo/web/templates/about.html:76
msgid "Classify"
msgstr "Classifica"

#: src/stimmo/web/templates/about.html:76
msgid ""
"Compare asking price to an ask-shifted band (rogito + 6 %). ±5 % around "
"it is fair."
msgstr ""
"Confronta il prezzo richiesto con una fascia shiftata (rogito + 6 %). ±5 "
"% attorno è equo."

#: src/stimmo/web/templates/about.html:82
msgid "Data sources"
msgstr "Fonti dei dati"

#: src/stimmo/web/templates/about.html:87
#, python-format
msgid "microzones · Milano · %(semester)s"
msgstr "microzone · Milano · %(semester)s"

#: src/stimmo/web/templates/about.html:89
msgid "OMI quotations"
msgstr "Quotazioni OMI"

#: src/stimmo/web/templates/about.html:90
#: src/stimmo/web/templates/about.html:103
#: src/stimmo/web/templates/about.html:116
#: src/stimmo/web/templates/about.html:129
msgid "Bundled"
msgstr "Incluso"

#: src/stimmo/web/templates/about.html:91
msgid ""
"Per-zone €/m² ranges for sales, split by property type and condition "
"(Normale / Scadente / Ottimo). The spine of every estimate."
msgstr ""
"Intervalli €/m² per zona per le vendite, suddivisi per tipologia "
"immobiliare e stato (Normale / Scadente / Ottimo). La spina dorsale di "
"ogni stima."

#: src/stimmo/web/templates/about.html:93
#: src/stimmo/web/templates/about.html:106
#: src/stimmo/web/templates/about.html:119
#: src/stimmo/web/templates/about.html:132
#: src/stimmo/web/templates/about.html:145
#: src/stimmo/web/templates/about.html:158
msgid "License"
msgstr "Licenza"

#: src/stimmo/web/templates/about.html:94
#: src/stimmo/web/templates/about.html:107
#: src/stimmo/web/templates/about.html:120
#: src/stimmo/web/templates/about.html:133
#: src/stimmo/web/templates/about.html:146
#: src/stimmo/web/templates/about.html:159
msgid "File"
msgstr "File"

#: src/stimmo/web/templates/about.html:100
msgid "comune · no metropolitan belt"
msgstr "comune · senza cintura metropolitana"

#: src/stimmo/web/templates/about.html:102
msgid "OMI zone polygons"
msgstr "Poligoni delle zone OMI"

#: src/stimmo/web/templates/about.html:104
msgid ""
"Microzone shapes used for point-in-polygon zone assignment. Comune di "
"Milano only — addresses outside the comune are rejected."
msgstr ""
"Forme delle microzone utilizzate per l'assegnazione della zona tramite "
"punto-in-poligono. Solo Comune di Milano — gli indirizzi fuori dal comune"
" vengono rifiutati."

#: src/stimmo/web/templates/about.html:113
msgid "semesters · ~4 years"
msgstr "semestri · ~4 anni"

#: src/stimmo/web/templates/about.html:115
msgid "OMI history"
msgstr "Storico OMI"

#: src/stimmo/web/templates/about.html:117
msgid ""
"Trailing 8 semesters (~4 years) of bands per zone × type × condition. "
"Drives the trend strip on the report."
msgstr ""
"Ultimi 8 semestri (~4 anni) di fasce per zona × tipologia × stato. Guida "
"la striscia di tendenza nel report."

#: src/stimmo/web/templates/about.html:126
msgid "quarterly · by surface bucket"
msgstr "trimestrale · per fascia di superficie"

#: src/stimmo/web/templates/about.html:128
msgid "transactions"
msgstr "transazioni"

#: src/stimmo/web/templates/about.html:130
msgid ""
"Numero di Transazioni Normalizzate, quarterly. Shown for market context "
"only — never used as a pricing input."
msgstr ""
"Numero di Transazioni Normalizzate, trimestrale. Mostrato solo per "
"contesto di mercato — mai usato come input di prezzo."

#: src/stimmo/web/templates/about.html:139
msgid "request per estimate"
msgstr "richiesta per stima"

#: src/stimmo/web/templates/about.html:141
msgid "geocoding"
msgstr "geocodifica"

#: src/stimmo/web/templates/about.html:142
#: src/stimmo/web/templates/about.html:155
msgid "Live"
msgstr "Live"

#: src/stimmo/web/templates/about.html:143
msgid ""
"Free geocoder, called once per estimate. Queries are scoped to Milano to "
"avoid stray matches."
msgstr ""
"Geocoder gratuito, chiamato una volta per stima. Le query sono limitate a"
" Milano per evitare corrispondenze errate."

#: src/stimmo/web/templates/about.html:152
msgid "radius · 6 categories"
msgstr "raggio · 6 categorie"

#: src/stimmo/web/templates/about.html:154
msgid "amenities"
msgstr "servizi"

#: src/stimmo/web/templates/about.html:156
msgid ""
"Counts of schools, pharmacies, markets, transit stops and parks within "
"500 m. If unreachable, the estimate still renders with a zero amenity "
"score and a warning."
msgstr ""
"Conteggi di scuole, farmacie, mercati, fermate dei mezzi e parchi entro "
"500 m. Se non raggiungibile, la stima viene comunque generata con "
"punteggio servizi pari a zero e un avviso."

#: src/stimmo/web/templates/about.html:168
msgid "No machine learning."
msgstr "Niente machine learning."

#: src/stimmo/web/templates/about.html:170
msgid ""
"stimmo has no trained model. The entire tuning surface is a single\n"
"      file — <span class=\"mono\">valuation/adjustments.py</span>. Every\n"
"      multiplier (floor, lift, energy, outdoor, era, orientation, "
"amenities)\n"
"      lives there in plain Python."
msgstr ""
"stimmo non ha un modello addestrato. L'intera superficie di regolazione è"
" un singolo\n"
"      file — <span class=\"mono\">valuation/adjustments.py</span>. Ogni\n"
"      moltiplicatore (piano, ascensore, energia, esterno, epoca, "
"orientamento, servizi)\n"
"      vive lì in Python semplice."

#: src/stimmo/web/templates/about.html:176
msgid ""
"The verdict is <em>deterministic</em>: same inputs, same output.\n"
"      If you disagree with a coefficient, you can read the line where it "
"lives,\n"
"      change it, and re-run."
msgstr ""
"Il verdetto è <em>deterministico</em>: stessi input, stesso output.\n"
"      Se non sei d'accordo con un coefficiente, puoi leggere la riga in "
"cui si trova,\n"
"      modificarla e rieseguire."

#: src/stimmo/web/templates/about.html:191
msgid "Ask-shifted, not rogito."
msgstr "Basato sul prezzo richiesto, non sul rogito."

#: src/stimmo/web/templates/about.html:193
msgid ""
"OMI publishes <em>transacted</em> prices — what changed hands at the\n"
"      notary, after negotiation. In Milano, asking prices typically run\n"
"      <b> 5–10 %</b> above the eventual sale price."
msgstr ""
"OMI pubblica prezzi <em>transatti</em> — ciò che è passato di mano dal\n"
"      notaio, dopo la negoziazione. A Milano, i prezzi richiesti sono "
"tipicamente\n"
"      <b> 5–10 %</b> superiori al prezzo di vendita finale."

#: src/stimmo/web/templates/about.html:217
msgid ""
"We shift the OMI band upward by a fixed <b>+6 %</b> ask-premium before\n"
"      classifying. ±5 % around the shifted band is \"fair\". The constant"
" lives\n"
"      in <span class=\"mono\">verdict.py::ASK_PREMIUM_PCT</span>."
msgstr ""
"Spostiamo la fascia OMI verso l'alto di un premio sul prezzo richiesto "
"fisso del <b>+6 %</b> prima\n"
"      della classificazione. ±5 % attorno alla fascia spostata è "
"\"giusto\". La costante si trova\n"
"      in <span class=\"mono\">verdict.py::ASK_PREMIUM_PCT</span>."

#: src/stimmo/web/templates/about.html:225
msgid "What stimmo doesn't model"
msgstr "Cosa stimmo non modella"

#: src/stimmo/web/templates/about.html:230
msgid ""
"Routine condominium fees and extraordinary works (lavori straordinari "
"deliberati). Can shift true cost €10–50 k. Invisible to OMI."
msgstr ""
"Spese condominiali ordinarie e lavori straordinari deliberati. Possono "
"spostare il costo reale di €10–50 k. Invisibili all'OMI."

#: src/stimmo/web/templates/about.html:235
msgid ""
"The classic 1° piano premium in storied buildings. Inside the same "
"building, can drive ±5–10 %."
msgstr ""
"Il classico premio del 1° piano negli edifici storici. All'interno dello "
"stesso edificio, può determinare ±5–10 %."

#: src/stimmo/web/templates/about.html:239
msgid "Street noise &amp; view"
msgstr "Rumore stradale &amp; vista"

#: src/stimmo/web/templates/about.html:240
msgid ""
"A unit on a quiet cortile vs. one on Corso Buenos Aires. OMI averages, "
"doesn't see this."
msgstr ""
"Un'unità su un cortile tranquillo vs. una su Corso Buenos Aires. L'OMI fa"
" una media, non vede questo."

#: src/stimmo/web/templates/about.html:244
msgid "Comparable listings"
msgstr "Annunci comparabili"

#: src/stimmo/web/templates/about.html:245
msgid ""
"Italian per-transaction sale data isn't public. We don't fit a model on "
"stale asking prices — by design."
msgstr ""
"I dati sulle vendite effettive in Italia non sono pubblici. Per scelta, "
"non addestriamo un modello su prezzi richiesti obsoleti."

#: src/stimmo/web/templates/about.html:249
msgid "Metropolitan belt"
msgstr "Cintura metropolitana"

#: src/stimmo/web/templates/about.html:250
msgid ""
"Sesto, Cinisello, Cologno, Rho — outside the Milano comune polygon. Will "
"fail with \"outside Milano\"."
msgstr ""
"Sesto, Cinisello, Cologno, Rho — fuori dal poligono del comune di Milano."
" Fallirà con \"fuori Milano\"."

#: src/stimmo/web/templates/about.html:254
msgid "Commercial property"
msgstr "Immobile commerciale"

#: src/stimmo/web/templates/about.html:255
msgid ""
"Shops, offices, ateliers — different OMI category, different dynamics. "
"Residential subtypes only."
msgstr ""
"Negozi, uffici, atelier — categoria OMI diversa, dinamiche diverse. Solo "
"sottotipi residenziali."

#: src/stimmo/web/templates/about.html:262
msgid "not a perizia"
msgstr "non è una perizia"

#: src/stimmo/web/templates/about.html:263
msgid "fairness check"
msgstr "controllo di congruità"

#: src/stimmo/web/templates/about.html:266
msgid "stimmo is a fairness check, not an official appraisal."
msgstr "stimmo è un controllo di congruità, non una perizia ufficiale."

#: src/stimmo/web/templates/about.html:267
msgid ""
"It does not replace a qualified <em>perito</em> and should not be used as"
" the basis for legal, fiscal, or contractual decisions. Use it to sanity-"
"check an asking price, negotiate, or walk away — not to sign anything."
msgstr ""
"Non sostituisce un <em>perito</em> qualificato e non deve essere "
"utilizzato come base per decisioni legali, fiscali o contrattuali. Usalo "
"per verificare un prezzo richiesto, negoziare o rinunciare — non per "
"firmare nulla."

#: src/stimmo/web/templates/about.html:272
msgid "Run an estimate"
msgstr "Esegui una stima"

#: src/stimmo/web/templates/about.html:273
msgid "Install the bookmarklet"
msgstr "Installa il bookmarklet"

#: src/stimmo/web/templates/about.html:277
msgid "Built by"
msgstr "Realizzato da"

#: src/stimmo/web/templates/about.html:278
msgid "stimmo is open source — view the code on"
msgstr "stimmo è open source — vedi il codice su"

#: src/stimmo/web/templates/about.html:279
msgid "Have a feature request, found a bug, or want to suggest an improvement?"
msgstr ""
"Hai una richiesta di funzionalità, hai trovato un bug o vuoi suggerire un"
" miglioramento?"

#: src/stimmo/web/templates/about.html:280
msgid "Open a GitHub issue"
msgstr "Apri una issue su GitHub"

#: src/stimmo/web/templates/base.html:873
msgid "Fair-price check"
msgstr "Controllo prezzo equo"

#: src/stimmo/web/templates/base.html:877
msgid "Estimate"
msgstr "Stima"

#: src/stimmo/web/templates/base.html:878
msgid "Bookmarklet"
msgstr "Bookmarklet"

#: src/stimmo/web/templates/base.html:890
msgid "By"
msgstr "Da"

#: src/stimmo/web/templates/base.html:894
msgid "Requests &amp; feedback"
msgstr "Richieste e feedback"

#: src/stimmo/web/templates/bookmarklet.html:2
msgid "bookmarklet"
msgstr "bookmarklet"

#: src/stimmo/web/templates/bookmarklet.html:8
msgid "Import"
msgstr "Importa"

#: src/stimmo/web/templates/bookmarklet.html:10
#: src/stimmo/web/templates/form.html:8 src/stimmo/web/templates/form.html:32
#: src/stimmo/web/templates/result.html:8
msgid "Listing"
msgstr "Annuncio"

#: src/stimmo/web/templates/bookmarklet.html:12
#: src/stimmo/web/templates/form.html:10
#: src/stimmo/web/templates/result.html:10
msgid "Verdict"
msgstr "Giudizio"

#: src/stimmo/web/templates/bookmarklet.html:14
msgid "One click, <em>prefilled</em>."
msgstr "Un clic, <em>precompilato</em>."

#: src/stimmo/web/templates/bookmarklet.html:16
msgid ""
"Drag the pill below to your bookmarks bar. Click it on any\n"
"      <span class=\"mono\" style=\"font-size:13px\">immobiliare.it</span>"
" Milano listing — stimmo opens with\n"
"      address, surface, price, floor, lift, energy class, condition, "
"outdoor space, era and bathrooms already filled in."
msgstr ""
"Trascina la pillola qui sotto nella barra dei segnalibri. Cliccala su "
"qualsiasi annuncio Milano di\n"
"      <span class=\"mono\" style=\"font-size:13px\">immobiliare.it</span>"
" — stimmo si apre con\n"
"      indirizzo, superficie, prezzo, piano, ascensore, classe energetica,"
" stato, spazio esterno, epoca e bagni già compilati."

#: src/stimmo/web/templates/bookmarklet.html:22
msgid "Privacy"
msgstr "Privacy"

#: src/stimmo/web/templates/bookmarklet.html:23
msgid "browser-only"
msgstr "solo browser"

#: src/stimmo/web/templates/bookmarklet.html:24
msgid "no immobiliare<br>request from us"
msgstr "nessuna richiesta<br>immobiliare da parte nostra"

#: src/stimmo/web/templates/bookmarklet.html:32
msgid "Drag to your bookmarks bar"
msgstr "Trascina nella barra dei segnalibri"

#: src/stimmo/web/templates/bookmarklet.html:33
msgid "Install"
msgstr "Installa"

#: src/stimmo/web/templates/bookmarklet.html:42
msgid "check this listing"
msgstr "controlla questo annuncio"

#: src/stimmo/web/templates/bookmarklet.html:45
#: src/stimmo/web/templates/bookmarklet.html:207
msgid "Copy link"
msgstr "Copia link"

#: src/stimmo/web/templates/bookmarklet.html:52
msgid "your bookmarks bar"
msgstr "la tua barra dei segnalibri"

#: src/stimmo/web/templates/bookmarklet.html:58
msgid "How it works"
msgstr "Come funziona"

#: src/stimmo/web/templates/bookmarklet.html:59
msgid "Three steps"
msgstr "Tre passaggi"

#: src/stimmo/web/templates/bookmarklet.html:65
msgid "Drag the pill"
msgstr "Trascina la pillola"

#: src/stimmo/web/templates/bookmarklet.html:65
msgid "above to your browser's bookmarks bar."
msgstr "sopra nella barra dei segnalibri del tuo browser."

#: src/stimmo/web/templates/bookmarklet.html:66
msgid ""
"Show it with <span class=\"kbd\">⌘</span><span "
"class=\"kbd\">⇧</span><span class=\"kbd\">B</span> on Mac, <span "
"class=\"kbd\">Ctrl</span><span class=\"kbd\">⇧</span><span "
"class=\"kbd\">B</span> on Windows."
