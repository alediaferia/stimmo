#: src/stimmo/web/templates/about.html:10 src/stimmo/web/templates/base.html:9
#: src/stimmo/web/templates/base.html:14 src/stimmo/web/templates/base.html:21
#: src/stimmo/web/templates/form.html:10
#: src/stimmo/web/templates/result.html:19
#: src/stimmo/web/templates/result.html:25
msgid ""
"Fair-price check for Milan apartment listings — OMI-anchored, no machine "
"learning, every multiplier visible."
msgstr ""
"Controllo del prezzo equo per annunci di appartamenti a Milano — ancorato"
" all'OMI, nessun machine learning, ogni moltiplicatore visibile."

#: src/stimmo/web/templates/about.html:32
#: src/stimmo/web/templates/base.html:994
msgid "About"
msgstr "Informazioni"

#: src/stimmo/web/templates/about.html:34
msgid "How stimmo turns an address<br>into <em>a verdict</em>."
msgstr "Come stimmo trasforma un indirizzo<br>in <em>un verdetto</em>."

#: src/stimmo/web/templates/about.html:35
msgid ""
"A six-step pipeline, one coefficients file, no machine learning. Same "
"inputs, same output — every time."
msgstr ""
"Una pipeline in sei fasi, un file di coefficienti, nessun machine "
"learning. Stessi input, stesso output — sempre."

#: src/stimmo/web/templates/about.html:38
#: src/stimmo/web/templates/form.html:243
msgid "Methodology"
msgstr "Metodologia"

#: src/stimmo/web/templates/about.html:40
msgid "microzones · Milano"
msgstr "microzone · Milano"

#: src/stimmo/web/templates/about.html:50
msgid ""
"A transparent, OMI-anchored fair-price check<br>\n"
"      for Milan apartment listings."
msgstr ""
"Un controllo del prezzo equo trasparente e ancorato all'OMI<br>\n"
"      per gli annunci di appartamenti a Milano."

#: src/stimmo/web/templates/about.html:63
#: src/stimmo/web/templates/result.html:67
msgid "fair"
msgstr "equo"

#: src/stimmo/web/templates/about.html:64
msgid "over"
msgstr "sopra"

#: src/stimmo/web/templates/about.html:65
msgid "under"
msgstr "sotto"

#: src/stimmo/web/templates/about.html:66
msgid "Verdicts"
msgstr "Verdetti"

#: src/stimmo/web/templates/about.html:74
msgid "The pipeline"
msgstr "La pipeline"

#: src/stimmo/web/templates/about.html:75
msgid "Address → verdict · 6 steps"
msgstr "Indirizzo → verdetto · 6 passaggi"

#: src/stimmo/web/templates/about.html:80
msgid "Geocode"
msgstr "Geocodifica"

#: src/stimmo/web/templates/about.html:80
msgid ""
"OSM Nominatim resolves the address to lat / lon. Queries are restricted "
"to Milano comune."
msgstr ""
"OSM Nominatim risolve l'indirizzo in lat / lon. Le query sono limitate al"
" comune di Milano."

#: src/stimmo/web/templates/about.html:84
msgid "Locate the OMI zone"
msgstr "Individua la zona OMI"

#: src/stimmo/web/templates/about.html:84
msgid "Point-in-polygon against Milano's official OMI microzone shapes."
msgstr ""
"Punto-in-poligono rispetto alle forme ufficiali delle microzone OMI di "
"Milano."

#: src/stimmo/web/templates/about.html:88
msgid "Pull the €/m² band"
msgstr "Preleva la fascia €/m²"

#: src/stimmo/web/templates/about.html:88
msgid "Compr_min – Compr_max for that zone × property type × condition bucket."
msgstr ""
"Compr_min – Compr_max per quella zona × tipo di proprietà × fascia di "
"condizione."

#: src/stimmo/web/templates/about.html:92
msgid "Count amenities"
msgstr "Conta i servizi"

#: src/stimmo/web/templates/about.html:92
msgid "OSM Overpass — schools, transit, markets, pharmacies, parks within 500 m."
msgstr "OSM Overpass — scuole, trasporti, mercati, farmacie, parchi entro 500 m."

#: src/stimmo/web/templates/about.html:96
msgid "Adjust the band"
msgstr "Regola la fascia"

#: src/stimmo/web/templates/about.html:96
msgid ""
"A single coefficients table multiplies floor, lift, size, condition, "
"energy, outdoor, era, orientation, exposure, room density, second "
"bathroom, parking box, and amenities."
msgstr ""
"Un'unica tabella di coefficienti moltiplica piano, ascensore, superficie,"
" condizione, energia, esterno, epoca, orientamento, esposizione, densità "
"vani, secondo bagno, box auto e servizi."

#: src/stimmo/web/templates/about.html:100
msgid "Classify"
msgstr "Classifica"

#: src/stimmo/web/templates/about.html:100
msgid ""
"Compare asking price to an ask-shifted band (rogito + 6 %). ±5 % around "
"it is fair."
msgstr ""
"Confronta il prezzo richiesto con una fascia shiftata (rogito + 6 %). "
"Intorno al ±5 % è equo."

#: src/stimmo/web/templates/about.html:106
msgid "Data sources"
msgstr "Fonti dei dati"

#: src/stimmo/web/templates/about.html:111
#, python-format
msgid "microzones · Milano · %(semester)s"
msgstr "microzone · Milano · %(semester)s"

#: src/stimmo/web/templates/about.html:113
msgid "OMI quotations"
msgstr "Quotazioni OMI"

#: src/stimmo/web/templates/about.html:114
#: src/stimmo/web/templates/about.html:127
#: src/stimmo/web/templates/about.html:140
#: src/stimmo/web/templates/about.html:153
msgid "Bundled"
msgstr "Incluso"

#: src/stimmo/web/templates/about.html:115
msgid ""
"Per-zone €/m² ranges for sales, split by property type and condition "
"(Normale / Scadente / Ottimo). The spine of every estimate."
msgstr ""
"Fasce €/m² per zona per le vendite, suddivise per tipo di proprietà e "
"condizione (Normale / Scadente / Ottimo). La spina dorsale di ogni stima."

#: src/stimmo/web/templates/about.html:117
#: src/stimmo/web/templates/about.html:130
#: src/stimmo/web/templates/about.html:143
#: src/stimmo/web/templates/about.html:156
#: src/stimmo/web/templates/about.html:169
#: src/stimmo/web/templates/about.html:182
msgid "License"
msgstr "Licenza"

#: src/stimmo/web/templates/about.html:118
#: src/stimmo/web/templates/about.html:131
#: src/stimmo/web/templates/about.html:144
#: src/stimmo/web/templates/about.html:157
#: src/stimmo/web/templates/about.html:170
#: src/stimmo/web/templates/about.html:183
msgid "File"
msgstr "File"

#: src/stimmo/web/templates/about.html:124
msgid "comune · no metropolitan belt"
msgstr "comune · senza cintura metropolitana"

#: src/stimmo/web/templates/about.html:126
msgid "OMI zone polygons"
msgstr "Poligoni delle zone OMI"

#: src/stimmo/web/templates/about.html:128
msgid ""
"Microzone shapes used for point-in-polygon zone assignment. Comune di "
"Milano only — addresses outside the comune are rejected."
msgstr ""
"Forme delle microzone per assegnazione punto-in-poligono. Solo Comune di "
"Milano — gli indirizzi fuori dal comune sono scartati."

#: src/stimmo/web/templates/about.html:137
msgid "semesters · ~4 years"
msgstr "semestri · ~4 anni"

#: src/stimmo/web/templates/about.html:139
msgid "OMI history"
msgstr "Storico OMI"

#: src/stimmo/web/templates/about.html:141
msgid ""
"Trailing 8 semesters (~4 years) of bands per zone × type × condition. "
"Drives the trend strip on the report."
msgstr ""
"Ultimi 8 semestri (~4 anni) di fasce per zona × tipologia × stato. "
"Alimenta la striscia di tendenza nel report."

#: src/stimmo/web/templates/about.html:150
msgid "quarterly · by surface bucket"
msgstr "trimestrale · per fascia di superficie"

#: src/stimmo/web/templates/about.html:152
msgid "transactions"
msgstr "transazioni"

#: src/stimmo/web/templates/about.html:154
msgid ""
"Numero di Transazioni Normalizzate, quarterly. Shown for market context "
"only — never used as a pricing input."
msgstr ""
"Numero di Transazioni Normalizzate, trimestrale. Mostrato solo per "
"contesto di mercato — mai usato come input di prezzo."

#: src/stimmo/web/templates/about.html:163
msgid "request per estimate"
msgstr "richiesta per stima"

#: src/stimmo/web/templates/about.html:165
msgid "geocoding"
msgstr "geocodifica"

#: src/stimmo/web/templates/about.html:166
#: src/stimmo/web/templates/about.html:179
msgid "Live"
msgstr "Live"

#: src/stimmo/web/templates/about.html:167
msgid ""
"Free geocoder, called once per estimate. Queries are scoped to Milano to "
"avoid stray matches."
msgstr ""
"Geocodifica gratuita, chiamata una volta per stima. Le query sono "
"limitate a Milano per evitare corrispondenze errate."

#: src/stimmo/web/templates/about.html:176
msgid "radius · 6 categories"
msgstr "raggio · 6 categorie"

#: src/stimmo/web/templates/about.html:178
msgid "amenities"
msgstr "servizi"

#: src/stimmo/web/templates/about.html:180
msgid ""
"Counts of schools, pharmacies, markets, transit stops and parks within "
"500 m. If unreachable, the estimate still renders with a zero amenity "
"score and a warning."
msgstr ""
"Conteggio di scuole, farmacie, mercati, fermate dei trasporti e parchi "
"entro 500 m. Se non raggiungibile, la stima viene comunque generata con "
"punteggio servizi pari a zero e un avviso."

#: src/stimmo/web/templates/about.html:192
msgid "No machine learning."
msgstr "Niente machine learning."

#: src/stimmo/web/templates/about.html:194
msgid ""
"stimmo has no trained model. The entire tuning surface is a single\n"
"      file — <span class=\"mono\">valuation/adjustments.py</span>. Every\n"
"      multiplier (floor, lift, size, condition, energy, outdoor, era, "
"orientation,\n"
"      exposure, room density, second bathroom, parking box, and "
"amenities)\n"
"      lives there in plain Python."
msgstr ""
"stimmo non ha un modello addestrato. L'intera superficie di regolazione è"
" un singolo\n"
"      file — <span class=\"mono\">valuation/adjustments.py</span>. Ogni\n"
"      moltiplicatore (piano, ascensore, superficie, stato, energetico, "
"esterno, epoca, orientamento,\n"
"      esposizione, densità stanze, secondo bagno, box auto e servizi)\n"
"      vive lì in Python puro."

#: src/stimmo/web/templates/about.html:201
msgid ""
"The verdict is <em>deterministic</em>: same inputs, same output.\n"
"      If you disagree with a coefficient, you can read the line where it "
"lives,\n"
"      change it, and re-run."
msgstr ""
"Il verdetto è <em>deterministico</em>: stessi input, stesso output.\n"
"      Se non sei d'accordo con un coefficiente, puoi leggere la riga in "
"cui si trova,\n"
"      modificarla e rieseguire."

#: src/stimmo/web/templates/about.html:216
msgid "Ask-shifted, not rogito."
msgstr "Shiftato sul prezzo richiesto, non sul rogito."

#: src/stimmo/web/templates/about.html:218
msgid ""
"OMI publishes <em>transacted</em> prices — what changed hands at the\n"
"      notary, after negotiation. In Milano, asking prices typically run\n"
"      <b> 5–10 %</b> above the eventual sale price."
msgstr ""
"OMI pubblica prezzi <em>transati</em> — ciò che è passato di mano dal\n"
"      notaio, dopo la trattativa. A Milano, i prezzi richiesti sono "
"tipicamente\n"
"      <b> 5–10 %</b> sopra il prezzo di vendita finale."

#: src/stimmo/web/templates/about.html:242
msgid ""
"We shift the OMI band upward by a fixed <b>+6 %</b> ask-premium before\n"
"      classifying. ±5 % around the shifted band is \"fair\". The constant"
" lives\n"
"      in <span class=\"mono\">verdict.py::ASK_PREMIUM_PCT</span>."
msgstr ""
"Spostiamo la fascia OMI verso l'alto di un premio sul richiesto fisso del"
" <b>+6 %</b> prima\n"
"      della classificazione. Il ±5 % attorno alla fascia spostata è "
"\"giusto\". La costante vive\n"
"      in <span class=\"mono\">verdict.py::ASK_PREMIUM_PCT</span>."

#: src/stimmo/web/templates/about.html:250
msgid "What stimmo doesn't model"
msgstr "Cosa stimmo non modella"

#: src/stimmo/web/templates/about.html:255
msgid ""
"Routine condominium fees and extraordinary works (lavori straordinari "
"deliberati). Can shift true cost €10–50 k. Invisible to OMI."
msgstr ""
"Spese condominiali ordinarie e lavori straordinari (lavori straordinari "
"deliberati). Possono spostare il costo reale di €10-50 k. Invisibili "
"all'OMI."

#: src/stimmo/web/templates/about.html:260
msgid ""
"The classic 1° piano premium in storied buildings. Inside the same "
"building, can drive ±5–10 %."
msgstr ""
"Il classico premium del 1° piano negli edifici storici. All'interno dello"
" stesso edificio, può determinare ±5-10 %."

#: src/stimmo/web/templates/about.html:264
msgid "Street noise &amp; view"
msgstr "Rumore stradale &amp; vista"

#: src/stimmo/web/templates/about.html:265
msgid ""
"A unit on a quiet cortile vs. one on Corso Buenos Aires. OMI averages, "
"doesn't see this."
msgstr ""
"Un'unità su un cortile tranquillo vs. una su Corso Buenos Aires. L'OMI fa"
" una media, non vede questo."

#: src/stimmo/web/templates/about.html:269
msgid "Comparable listings"
msgstr "Annunci comparabili"

#: src/stimmo/web/templates/about.html:270
msgid ""
"Italian per-transaction sale data isn't public. We don't fit a model on "
"stale asking prices — by design."
msgstr ""
"I dati italiani di vendita per transazione non sono pubblici. Non "
"adattiamo un modello su prezzi richiesti obsoleti — di proposito."

#: src/stimmo/web/templates/about.html:274
msgid "Metropolitan belt"
msgstr "Cintura metropolitana"

#: src/stimmo/web/templates/about.html:275
msgid ""
"Sesto, Cinisello, Cologno, Rho — outside the Milano comune polygon. Will "
"fail with \"outside Milano\"."
msgstr ""
"Sesto, Cinisello, Cologno, Rho — fuori dal poligono del comune di Milano."
" Fallirà con \"fuori Milano\"."

#: src/stimmo/web/templates/about.html:279
msgid "Commercial property"
msgstr "Proprietà commerciale"

#: src/stimmo/web/templates/about.html:280
msgid ""
"Shops, offices, ateliers — different OMI category, different dynamics. "
"Residential subtypes only."
msgstr ""
