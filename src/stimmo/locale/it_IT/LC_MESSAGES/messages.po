#: src/stimmo/models.py:18
msgid "Street-facing"
msgstr "Su strada"

#: src/stimmo/models.py:19
msgid "Mixed (street + courtyard)"
msgstr "Misto (strada + cortile)"

#: src/stimmo/models.py:20
msgid "Internal courtyard"
msgstr "Cortile interno"

#: src/stimmo/models.py:33
msgid ""
"Upscale residential — post-2000 build or prestigious older building, "
"doorman (portineria), marble/parquet finish, prime zone. Pick this if the"
" listing explicitly markets 'signorile'."
msgstr ""
"Residenziale di pregio — costruzione post-2000 o edificio antico "
"prestigioso, portineria, finiture in marmo/parquet, zona premium. Scegli "
"questa se l'annuncio pubblicizza esplicitamente 'signorile'."

#: src/stimmo/models.py:38
msgid ""
"Standard residential — typical condominium 1960s–90s, ordinary finishes, "
"no doorman (most common choice for anything that doesn't clearly fit "
"another category)."
msgstr ""
"Residenziale standard — condominio tipico anni ’60–’90, finiture "
"ordinarie, senza portineria (scelta più comune per tutto ciò che non "
"rientra chiaramente in un'altra categoria)."

#: src/stimmo/models.py:42
msgid ""
"Economy residential — palazzina economica, peripheral or semi-peripheral "
"area, basic finishes, pre-1960s low-spec build or post-war INA-casa type."
msgstr ""
"Residenziale economica — palazzina economica, zona periferica o "
"semiperiferica, finiture base, costruzione pre-anni ’60 a basso costo o "
"tipo INA-casa del dopoguerra."

#: src/stimmo/models.py:46
msgid ""
"Detached houses and small villas — independent or semi-detached with "
"private garden/land."
msgstr ""
"Case indipendenti e villette — indipendenti o bifamiliari con "
"giardino/terreno privato."

#: src/stimmo/models.py:94
msgid "No outdoor space"
msgstr "Nessuno spazio esterno"

#: src/stimmo/models.py:95
msgid "Balcony"
msgstr "Balcone"

#: src/stimmo/models.py:96
msgid "Small terrace (≤ 10 m²)"
msgstr "Terrazzo piccolo (≤ 10 m²)"

#: src/stimmo/models.py:97
msgid "Large terrace (> 10 m²)"
msgstr "Terrazzo grande (> 10 m²)"

#: src/stimmo/models.py:110
msgid "Pre-war (before 1945)"
msgstr "Anteguerra (prima del 1945)"

#: src/stimmo/models.py:111
msgid "Post-war boom (1945–1980)"
msgstr "Boom del dopoguerra (1945–1980)"

#: src/stimmo/models.py:112
msgid "1980s–90s (1981–2000)"
msgstr "Anni ’80–’90 (1981–2000)"

#: src/stimmo/models.py:113
msgid "Contemporary (2001–2015)"
msgstr "Contemporaneo (2001–2015)"

#: src/stimmo/models.py:114
msgid "Recent (after 2015)"
msgstr "Recente (dopo il 2015)"

#: src/stimmo/models.py:125
msgid "South / south-west"
msgstr "Sud / sud-ovest"

#: src/stimmo/models.py:126
msgid "East / west / mixed"
msgstr "Est / ovest / misto"

#: src/stimmo/models.py:127
msgid "North / north-east"
msgstr "Nord / nord-est"

